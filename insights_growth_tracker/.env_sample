# === Gemini API Key ===
GEMINI_API_KEY="your-gemini-api-key-here"

# === LinkedIn Credentials (Avoid hardcoding; use OAuth if possible) ===
Linkedin_email="your-linkedin-email@example.com"
Linkedin_pass="your-linkedin-password"
LI_AT="your-linkedin-auth-cookie"

# === LinkedIn Session IDs ===
JSESSIONID_IN="your-jsessionid-in"
JSESSIONID_WWW="your-jsessionid-www"

# === LinkedIn Browser Cookies ===
BCOOKIE="your-bcookie"
BSCOOKIE_IN="your-bscookie-in"
BSCOOKIE_WWW="your-bscookie-www"

# === Data Center Routing ===
LIDC="your-lidc"

# === Preferences ===
LANG="v=2&lang=en-us"
TIMEZONE="Asia/Calcutta"
LI_THEME="light"
LI_THEME_SET="app"

# === Tracking & Analytics (Optional) ===
LI_SUGR="your-li-sugr"
GUID="your-guid"
LIAP="true"

# === Firebase Credentials ===
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-auth-domain"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-firebase-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-firebase-measurement-id"
